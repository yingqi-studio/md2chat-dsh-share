{
  "name": "md2chat-dsh-share",
  "version": "0.2.2",
  "description": "DeepSeek Harness plugin: share an assistant reply to WeChat, WeCom or email as chat-ready text and images, or export a Word document",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/client.js",
    "lib/docx/**",
    "lib/vendor/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "dev:patch": "node scripts/dev-patch.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "wecom",
    "share",
    "clipboard",
    "markdown",
    "md2chat"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "homepage": "https://github.com/yingqi-studio/md2chat-dsh-share#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yingqi-studio/md2chat-dsh-share.git"
  },
  "bugs": {
    "url": "https://github.com/yingqi-studio/md2chat-dsh-share/issues"
  }
}
